name: mistral
services:
  base:
    image: postgres:16.4-alpine
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - back
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 10s
  web:
    build: ./app
    image: mistral/colis:1.0
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER}@base:5432/${POSTGRES_DB}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
    ports:
      - "127.0.0.1:8080:8080"
    networks:
      - front
      - back
    depends_on:
      base:
        condition: service_healthy
  adminer:
    image: adminer:4.8.1
    profiles: ["outils"]
    ports:
      - "127.0.0.1:8082:8080"
    networks:
      - back
    depends_on:
      base:
        condition: service_healthy
networks:
  front:
  back:

volumes:
  pgdata:
